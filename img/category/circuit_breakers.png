<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f8fafc" />
      <stop offset="100%" stop-color="#e2e8f0" />
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ef4444" />
      <stop offset="100%" stop-color="#dc2626" />
    </linearGradient>
    <filter id="cardShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-opacity="0.12" flood-color="#0f172a" />
    </filter>
  </defs>

  <rect width="600" height="600" rx="20" fill="url(#bgGrad)" />
  
  <!-- Subtle grid pattern -->
  <g opacity="0.05" stroke="#000" stroke-width="1">
    <line x1="100" y1="0" x2="100" y2="600" />
    <line x1="200" y1="0" x2="200" y2="600" />
    <line x1="300" y1="0" x2="300" y2="600" />
    <line x1="400" y1="0" x2="400" y2="600" />
    <line x1="500" y1="0" x2="500" y2="600" />
    <line x1="0" y1="100" x2="600" y2="100" />
    <line x1="0" y1="200" x2="600" y2="200" />
    <line x1="0" y1="300" x2="600" y2="300" />
    <line x1="0" y1="400" x2="600" y2="400" />
    <line x1="0" y1="500" x2="600" y2="500" />
  </g>

  <!-- Central Product Container -->
  <g filter="url(#cardShadow)">
    <circle cx="300" cy="270" r="160" fill="#ffffff" />
    <circle cx="300" cy="270" r="150" fill="none" stroke="url(#accentGrad)" stroke-width="4" stroke-dasharray="6,6" />
  </g>

  <!-- Icon Graphics -->
  <g transform="translate(180, 150) scale(1.0)">
    <rect x="75" y="30" width="90" height="180" rx="10" fill="#f8fafc" stroke="#475569" stroke-width="6"/>
              <rect x="95" y="90" width="50" height="40" rx="6" fill="#ef4444"/>
              <circle cx="120" cy="60" r="10" fill="#22c55e"/>
              <line x1="90" y1="170" x2="150" y2="170" stroke="#94a3b8" stroke-width="4"/>
  </g>

  <!-- Badge / Category -->
  <g transform="translate(300, 480)">
    <rect x="-110" y="-18" width="220" height="36" rx="18" fill="url(#accentGrad)" />
    <text text-anchor="middle" y="6" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="700" letter-spacing="1">SWITCHGEAR</text>
  </g>

  <!-- Title & Code -->
  <text x="300" y="540" text-anchor="middle" fill="#0f172a" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="18" font-weight="700">Circuit Breakers</text>
  <text x="300" y="565" text-anchor="middle" fill="#64748b" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="600">CODE: CAT</text>

  <!-- Certified Voltix Emblem -->
  <g transform="translate(50, 50)">
    <rect width="90" height="26" rx="6" fill="#0f172a" />
    <text x="45" y="17" text-anchor="middle" fill="#fbbf24" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="10" font-weight="800" letter-spacing="0.5">⚡ VOLTIX</text>
  </g>
</svg>